{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  // Minimal on purpose: what is not declared here is not touched in production by `config push`.
  "project_id": "eslabon",
  "auth": {
    "site_url": "http://localhost:3000",
    "enable_signup": true,
    "minimum_password_length": 8,
    "email": {
      "enabled": true,
      "enable_confirmations": false
    }
  }
}
